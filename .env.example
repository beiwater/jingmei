# 本项目 .env 用冒号格式 `key: value`（不是 dotenv 的 KEY=value）。
# 业务配置在 jingmei.config.json（复制 jingmei.config.example.json）；这里只放 secret。
# key 名要与 jingmei.config.json 里的 tokenEnv / apiKeyEnv / routingSecretEnv 对应；进程环境变量优先于本文件。

# Discord bot token（persona 的 discord.tokenEnv）
DISCORD_LUNA_TOKEN: REPLACE_WITH_DISCORD_BOT_TOKEN

# 路由 HMAC 密钥；任意随机字符串
ROUTING_SECRET: REPLACE_WITH_RANDOM_LOCAL_SECRET

# DeepSeek：示例角色的模型调用、服务端联网搜索，也是进程内 Jev 包装器的默认 LLM key
DEEPSEEK_API_KEY: REPLACE_WITH_DEEPSEEK_API_KEY

# 以下按需启用，对应片段见 README「可选功能」：
# TELEGRAM_LUNA_TOKEN: 123456:REPLACE_WITH_BOTFATHER_TOKEN
# FISH_AUDIO_API_KEY: REPLACE_WITH_FISH_AUDIO_API_KEY
# TYPESAFE_API_KEY: REPLACE_WITH_TYPESAFE_API_KEY
