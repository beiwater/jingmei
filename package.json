{
	"name": "jingmei",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "精魅: an AI group pet for Discord and Telegram groups, built on Pi",
	"license": "BSD-2-Clause",
	"homepage": "https://github.com/beiwater/jingmei#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beiwater/jingmei.git"
	},
	"bugs": {
		"url": "https://github.com/beiwater/jingmei/issues"
	},
	"keywords": [
		"discord-bot",
		"telegram-bot",
		"ai-agent",
		"chatbot",
		"llm",
		"pi",
		"bun"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"start": "bun run src/main.ts",
		"jingmei": "bun run src/cli.ts",
		"test": "bun test",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@anush008/tokenizers-linux-arm64-gnu": "^0.6.0",
		"@clack/prompts": "1.8.1",
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"citty": "0.2.2",
		"fastembed": "3.0.0",
		"lunar-typescript": "1.8.6",
		"notjev": "0.2.1",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^24.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^5.9.0"
	},
	"trustedDependencies": [
		"onnxruntime-node"
	]
